# =====================================================================
# SIARRN — .gitignore
# =====================================================================

# --- Banco de dados local (criado em runtime) ---
# A barra inicial ancora a regra na raiz. Sem ela, "data/" casaria com
# qualquer pasta chamada data em qualquer profundidade — inclusive a
# camada de dados do app Android.
/data/
*.db
*.db-journal
*.db-wal
*.db-shm

# --- Estado local do totem (da máquina, nunca versionar) ---
# A fila de almoços e a cópia da base de alunos ficam em ~/.siarrn/, mas se
# alguém apontar o totem para uma pasta dentro do projeto, não vão para o git.
/.siarrn/
*.jsonl

# --- Bytecode e caches do Python ---
__pycache__/
*.py[cod]
*$py.class
*.pyo

# --- Ambientes virtuais ---
.venv/
venv/
env/
ENV/

# --- Android (app do aluno, fase 2) ---
.gradle/
local.properties
*.apk
*.aab
.kotlin/

# --- Distribuição / empacotamento ---
build/
dist/
*.egg-info/
*.egg

# --- Editores / IDEs ---
.vscode/
.idea/
*.iml
*.swp
*.swo
.DS_Store
Thumbs.db

# --- Logs e temporários ---
*.log
*.tmp
*.bak
~$*.docx
~$*.xlsx
~$*.pptx

# --- Saídas geradas ---
relatorios/
exports/
cartoes/
*.csv

# --- Artefatos locais do Claude/Cowork (não versionar) ---
.claude/
.agents/
skills-lock.json

# --- Chave de assinatura do app (NUNCA versionar) ---
# Sem ela ninguém consegue publicar uma atualização assinada como sendo a
# mesma aplicacao. Guarde uma cópia fora do computador.
*.jks
*.keystore
